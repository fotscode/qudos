---
let {prob, phase, width, label, size} = Astro.props
if (size === undefined){
    size=width/2.5
}
const radius = size * Math.sqrt(prob)
---
<div style="margin:0">
    <svg width={width} height={width} style="margin:0; ">
      <g transform={`translate(${ width / 2}, ${width/2})`}>
        <circle cx="0" cy="0" r=`${size}` style="fill: var(--sl-color-black); stroke: var(--sl-color-gray-2)" stroke-width="2" />
        <circle cx="0" cy="0" r={`${radius}`} style="fill: color-mix(in srgb, var(--sl-color-accent) 35%, transparent)" />
        <line x1="0" y1="0" x2={radius>0? size * Math.cos(-phase * Math.PI / 180): 0} y2={size * Math.sin(-phase * Math.PI / 180)} style="stroke: var(--sl-color-gray-4)" stroke-width="1" stroke-dasharray="3 3" />
        <line x1="0" y1="0" x2={radius * Math.cos(-phase * Math.PI / 180)} y2={radius * Math.sin(-phase * Math.PI / 180)} style="stroke: var(--sl-color-accent)" stroke-width="2.5" stroke-linecap="round" />
      </g>
    </svg>
    <div style="height:5px; margin:0px; margin-top:-20px">
    $${label}$$
    </div>
</div>
