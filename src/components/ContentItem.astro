---
import { Icon } from '@astrojs/starlight/components'
const BASE_URL = import.meta.env.BASE_URL

const contentMap = {
    qubitWiki: { title: 'El Cubit (Qudos) [Español]', url: `${BASE_URL}/concepts/qubit`, target: '_self' },
    xAxisWiki: { title: 'Puertas en eje X (Qudos) [Español]', url: `${BASE_URL}/gates/x-axis`, target: '_self' },
    yAxisWiki: { title: 'Puertas en eje Y (Qudos) [Español]', url: `${BASE_URL}/gates/y-axis`, target: '_self' },
    zAxisWiki: { title: 'Puertas en eje Z (Qudos) [Español]', url: `${BASE_URL}/gates/z-axis`, target: '_self' },
    hadamardWiki: { title: 'Puerta Hadamard (Qudos) [Español]', url: `${BASE_URL}/gates/hadamard`, target: '_self' },
    multipleCubitsWiki: { title: 'Múltiples Cubits (Qudos) [Español]', url: `${BASE_URL}/concepts/qubit#representación-de-múltiples-cubits`, target: '_self' },
    cnotWiki: { title: 'Puerta CNOT (Qudos) [Español]', url: `${BASE_URL}/gates/cnot`, target: '_self' },
    swapWiki: { title: 'Puerta SWAP (Qudos) [Español]', url: `${BASE_URL}/gates/swap`, target: '_self' },
    phaseKickbackWiki: { title: 'Retroceso de fase (Qudos) [Español]', url: `${BASE_URL}/concepts/phase-kickback`, target: '_self' },
    entanglementWiki: { title: 'Entrelazamiento (Qudos) [Español]', url: `${BASE_URL}/concepts/entanglement`, target: '_self' },
    oraclesWiki: { title: 'Oráculos (Qudos) [Español]', url: `${BASE_URL}/concepts/oracles`, target: '_self' },
    superdenseWiki: { title: 'Codificación superdensa (Qudos) [Español]', url: `${BASE_URL}/primitives/superdense-coding`, target: '_self' },
    teleportationWiki: { title: 'Teleportación cuántica (Qudos) [Español]', url: `${BASE_URL}/primitives/teleportation`, target: '_self' },
    noCloningWiki: { title: 'Teorema de no clonación (Qudos) [Español]', url: `${BASE_URL}/concepts/no-cloning-theorem`, target: '_self' },
    uncomputationWiki: { title: 'Descomputación (Qudos) [Español]', url: `${BASE_URL}/primitives/uncomputation`, target: '_self' },
    deutschWiki: { title: 'Algoritmo de Deutsch-Jozsa (Qudos) [Español]', url: `${BASE_URL}/algorithms/deutsch-jozsa`, target: '_self' },
    bernsteinVaziraniWiki: { title: 'Algoritmo de Bernstein-Vazirani (Qudos) [Español]', url: `${BASE_URL}/algorithms/bernstein-vazirani`, target: '_self' },
    groverWiki: { title: 'Algoritmo de Grover (Qudos) [Español]', url: `${BASE_URL}/algorithms/grover`, target: '_self' },
    amplitudeAmplificationWiki: { title: 'Amplificación de amplitudes (Qudos) [Español]', url: `${BASE_URL}/primitives/amplitude-amplification`, target: '_self' },
    fourierTransformWiki: { title: 'Transformada de Fourier cuántica (Qudos) [Español]', url: `${BASE_URL}/primitives/fourier-transform`, target: '_self' },
    phaseEstimationWiki: { title: 'Estimación de fase (Qudos) [Español]', url: `${BASE_URL}/primitives/phase-estimation`, target: '_self' },
    shorWiki: { title: 'Algoritmo de Shor (Qudos) [Español]', url: `${BASE_URL}/algorithms/shor`, target: '_self' },
    quantumGatesWiki: { title: 'Puertas cuánticas (Qudos) [Español]', url: `${BASE_URL}/gates/introduction`, target: '_self' },
}
type ContentItemType = keyof typeof contentMap
type AstroProps = {
    id: ContentItemType;
}
const { id } = Astro.props as AstroProps
const { title, url, target } = contentMap[id]
// Display-only: drop the repeated " (Qudos) [Español]" suffix; contentMap keeps the full title.
const label = title.replace(/\s*\(Qudos\)\s*\[Español\]\s*$/, '')
---
<style>
.content-item {
    margin: 0.15rem 0 0 !important;
}
.content-item a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-text-accent);
    text-decoration: none;
}
.content-item a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
}
</style>

<div class="content-item not-content">
    <a href={url} target={target} title={title}><Icon name="right-arrow" size="0.9em" />{label}</a>
</div>
