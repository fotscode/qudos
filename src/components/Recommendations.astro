---
import { Icon } from '@astrojs/starlight/components'
---
<style>
.legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.6rem 0.9rem;
    border: 1px dashed var(--qd-border);
    border-radius: var(--qd-radius-sm);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
}
.legend > * {
    margin: 0 !important;
}
.legend-title {
    font-weight: 600;
    color: var(--sl-color-white);
}
.item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
}
.rate {
    display: inline-flex;
    border-radius: 50%;
    color: white;
    padding: 1px;
}
.recommended { background: var(--qd-rate-recommended); }
.alternative { background: var(--qd-rate-alternative); }
.optional { background: var(--qd-rate-optional); }
</style>
<div class="legend not-content">
    <span class="legend-title">Bibliografía:</span>
    <span class="item"><span class="rate recommended"><Icon name="approve-check" size="1rem" /></span>Recomendada</span>
    <span class="item"><span class="rate alternative"><Icon name="approve-check" size="1rem" /></span>Alternativa</span>
    <span class="item"><span class="rate optional"><Icon name="approve-check" size="1rem" /></span>Opcional</span>
</div>
